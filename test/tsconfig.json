{
  "extends": "../kit/tsconfig.json",
  // SDK native helpers expose the same TypeScript graph as author builds.
  // Runtime Node resolves that graph through @wildshard/dev/test/node.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "erasableSyntaxOnly": false
  },
  "include": ["*.mjs"]
}
